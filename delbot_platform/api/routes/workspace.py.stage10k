from __future__ import annotations

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel

from delbot_platform.workspace.session_manager import SessionManager
from delbot_platform.research.research_engine import ResearchEngine


router = APIRouter(
    prefix="/api/workspace",
    tags=["Workspace"],
)


session_manager = SessionManager()

research_engine = ResearchEngine(
    session_manager,
)


class CreateSessionRequest(BaseModel):

    title: str = "Untitled Research"


class AskRequest(BaseModel):

    query: str


@router.post("/session")
def create_session(
    body: CreateSessionRequest,
):

    return session_manager.create(
        body.title
    )


@router.get("/sessions")
def sessions():

    return list(
        session_manager.sessions.values()
    )


@router.get("/{session_id}")
def get_session(
    session_id: str,
):

    session = session_manager.get(
        session_id
    )

    if session is None:

        raise HTTPException(
            status_code=404,
            detail="Session not found",
        )

    return session


@router.post("/{session_id}/ask")
def ask(
    session_id: str,
    body: AskRequest,
):

    session = session_manager.get(
        session_id
    )

    if session is None:

        raise HTTPException(
            status_code=404,
            detail="Session not found",
        )

    result = research_engine.ask(
        session_id=session_id,
        query=body.query,
        history=session["messages"],
    )

    session_manager.add_message(
        session_id,
        "user",
        body.query,
    )

    session_manager.add_message(
        session_id,
        "assistant",
        result["answer"],
    )

    updated = session_manager.get(
        session_id
    )

    return {
        "session_id": session_id,
        "answer": result["answer"],
        "sources": result.get(
            "sources",
            [],
        ),
        "research_state": result.get(
            "research_state",
            {},
        ),
        "messages": updated["messages"],
    }