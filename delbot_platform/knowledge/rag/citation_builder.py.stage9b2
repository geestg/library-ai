from __future__ import annotations

from delbot_platform.research.models import Citation


class CitationBuilder:

    def build(
        self,
        results: list[dict],
    ) -> list[dict]:

        citations: list[dict] = []

        for item in results:

            citation = Citation(
                document_id=item.get(
                    "document_id",
                    "",
                ),
                document_title=item.get(
                    "document_title",
                    "",
                ),
                file_path=item.get(
                    "source",
                    "",
                ),
                page=item.get(
                    "page",
                    0,
                ),
                chunk_id=item.get(
                    "chunk_id",
                    "",
                ),
                score=float(
                    item.get(
                        "score",
                        0.0,
                    )
                ),
                text=item.get(
                    "text",
                    "",
                ),
                metadata=item.get(
                    "metadata",
                    {},
                ),
            )

            citations.append(
                citation.export()
            )

        return citations