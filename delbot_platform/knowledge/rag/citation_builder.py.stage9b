from __future__ import annotations



class CitationBuilder:


    def build(
        self,
        results
    ):


        citations=[]


        for item in results:


            citations.append(

                {
                    "source":
                        item.get(
                            "source"
                        ),

                    "page":
                        item.get(
                            "page"
                        )

                }

            )


        return citations
