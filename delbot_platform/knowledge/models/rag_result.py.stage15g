from __future__ import annotations

from dataclasses import dataclass
from dataclasses import field

from delbot_platform.knowledge.models.document_chunk import DocumentChunk
from delbot_platform.research.models.citation import Citation


@dataclass(slots=True)
class RAGResult:

    query: str = ""

    documents: list[DocumentChunk] = field(
        default_factory=list,
    )

    context: str = ""

    citations: list[Citation] = field(
        default_factory=list,
    )

    @property
    def collections(
        self,
    ) -> list[str]:

        names: list[str] = []
        seen: set[str] = set()

        for chunk in self.documents:

            name = chunk.document.collection.name

            if not name:
                continue

            if name in seen:
                continue

            seen.add(name)
            names.append(name)

        return names

    @property
    def collection_ids(
        self,
    ) -> list[str]:

        ids: list[str] = []
        seen: set[str] = set()

        for chunk in self.documents:

            collection_id = (
                chunk.document.collection.collection_id
            )

            if not collection_id:
                continue

            if collection_id in seen:
                continue

            seen.add(collection_id)
            ids.append(collection_id)

        return ids

    @property
    def repositories(
        self,
    ) -> list[str]:

        names: list[str] = []
        seen: set[str] = set()

        for chunk in self.documents:

            repository = (
                chunk.document.collection.repository.name
            )

            if not repository:
                continue

            if repository in seen:
                continue

            seen.add(repository)
            names.append(repository)

        return names

    @property
    def repository_ids(
        self,
    ) -> list[str]:

        ids: list[str] = []
        seen: set[str] = set()

        for chunk in self.documents:

            repository_id = (
                chunk.document.collection.repository.repository_id
            )

            if not repository_id:
                continue

            if repository_id in seen:
                continue

            seen.add(repository_id)
            ids.append(repository_id)

        return ids

    def export(
        self,
    ) -> dict:

        return {
            "query": self.query,
            "documents": [
                document.export()
                for document in self.documents
            ],
            "context": self.context,
            "citations": [
                citation.export()
                for citation in self.citations
            ],
            "collections": self.collections,
            "collection_ids": self.collection_ids,
            "repositories": self.repositories,
            "repository_ids": self.repository_ids,
        }

    @classmethod
    def from_dict(
        cls,
        data: dict,
    ) -> "RAGResult":

        return cls(
            query=data.get(
                "query",
                "",
            ),
            documents=[
                DocumentChunk.from_dict(item)
                for item in data.get(
                    "documents",
                    [],
                )
            ],
            context=data.get(
                "context",
                "",
            ),
            citations=[
                Citation.from_dict(item)
                for item in data.get(
                    "citations",
                    [],
                )
            ],
        )