from __future__ import annotations

from dataclasses import dataclass
from dataclasses import field
from typing import Any

from delbot_platform.knowledge.models.knowledge_source import (
    KnowledgeSource,
)


@dataclass(slots=True)
class Repository:

    repository_id: str = ""

    name: str = ""

    root_path: str = ""

    source: KnowledgeSource = field(
        default_factory=KnowledgeSource,
    )

    metadata: dict[str, Any] = field(
        default_factory=dict,
    )

    @property
    def source_id(
        self,
    ) -> str:

        return self.source.source_id

    @property
    def source_name(
        self,
    ) -> str:

        return self.source.name

    def export(
        self,
    ) -> dict[str, Any]:

        return {
            "repository_id": self.repository_id,
            "name": self.name,
            "root_path": self.root_path,
            "source": self.source.export(),
            "source_id": self.source.source_id,
            "source_name": self.source.name,
            "metadata": self.metadata,
        }

    @classmethod
    def from_dict(
        cls,
        data: dict[str, Any],
    ) -> "Repository":

        if "source" in data:

            source = KnowledgeSource.from_dict(
                data["source"],
            )

        else:

            source = KnowledgeSource(
                source_id=data.get(
                    "source_id",
                    "",
                ),
                name=data.get(
                    "source_name",
                    "",
                ),
            )

        return cls(
            repository_id=data.get(
                "repository_id",
                "",
            ),
            name=data.get(
                "name",
                "",
            ),
            root_path=data.get(
                "root_path",
                "",
            ),
            source=source,
            metadata=data.get(
                "metadata",
                {},
            ),
        )