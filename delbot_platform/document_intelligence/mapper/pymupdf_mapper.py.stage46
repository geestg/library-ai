from __future__ import annotations

from typing import Any

from delbot_platform.document_intelligence.mapper.layout_mapper import (
    LayoutMapper,
)
from delbot_platform.document_intelligence.models.block import (
    Block,
)
from delbot_platform.document_intelligence.models.line import (
    Line,
)
from delbot_platform.document_intelligence.models.page import (
    Page,
)
from delbot_platform.document_intelligence.models.span import (
    Span,
)


class PyMuPDFMapper(LayoutMapper):

    def build_page(
        self,
        page_index: int,
        pymupdf_page: Any,
    ) -> Page:

        page = Page(
            page_index=page_index,
            page_number=page_index + 1,
        )

        layout = pymupdf_page.get_text(
            "dict",
        )

        for block_data in layout.get(
            "blocks",
            [],
        ):
            page.blocks.append(
                self._map_block(
                    block_data,
                ),
            )

        return page

    def _map_block(
        self,
        block_data: dict[str, Any],
    ) -> Block:

        block = Block()

        for line_data in block_data.get(
            "lines",
            [],
        ):
            block.lines.append(
                self._map_line(
                    line_data,
                ),
            )

        return block

    def _map_line(
        self,
        line_data: dict[str, Any],
    ) -> Line:

        line = Line()

        for span_data in line_data.get(
            "spans",
            [],
        ):
            line.spans.append(
                self._map_span(
                    span_data,
                ),
            )

        return line

    def _map_span(
        self,
        span_data: dict[str, Any],
    ) -> Span:

        return Span(
            text=span_data.get(
                "text",
                "",
            ),
            font_name=span_data.get(
                "font",
                "",
            ),
            font_size=float(
                span_data.get(
                    "size",
                    0.0,
                ),
            ),
        )
