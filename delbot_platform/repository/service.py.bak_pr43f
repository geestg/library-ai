from __future__ import annotations

import json
from pathlib import Path
from typing import List

from .catalog import CatalogAdapter
from .models import RepositoryItem


class RepositoryService:

    def __init__(self) -> None:

        self.root = Path(__file__).resolve().parents[1]

        self.metadata_dir = self.root / "repository_data" / "metadata"

        self.runtime_dir = self.root / "repository_data" / "runtime"

        self.overlay_file = self.runtime_dir / "repository_overlay.json"

        self.catalog_file = self.metadata_dir / "repository_catalog.json"

    # ------------------------------------------------------------------

    def scan(self) -> List[RepositoryItem]:

        if self.overlay_file.exists():

            return self._scan_overlay()

        return self._scan_catalog()

    # ------------------------------------------------------------------

    def _scan_overlay(self) -> List[RepositoryItem]:

        data = json.loads(
            self.overlay_file.read_text(
                encoding="utf-8"
            )
        )

        items = []

        for row in data:

            items.append(
                RepositoryItem(
                    id=row.get("document_id"),
                    title=row.get("title", ""),
                    author=row.get("author", ""),
                    year=row.get("year"),
                    abstract=row.get("abstract"),
                    local_path=row.get("pdf_path"),
                    status=row.get("status", "metadata_only")
                )
            )

        return items

    # ------------------------------------------------------------------

    def _scan_catalog(self) -> List[RepositoryItem]:

        adapter = CatalogAdapter(
            self.catalog_file
        )

        return adapter.load()

