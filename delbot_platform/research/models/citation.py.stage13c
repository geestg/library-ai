from __future__ import annotations

from dataclasses import dataclass
from dataclasses import field
from typing import Any

from delbot_platform.knowledge.models import Document


@dataclass(slots=True)
class Citation:

    document: Document

    page: int = 0

    chunk_id: str = ""

    score: float = 0.0

    text: str = ""

    metadata: dict[str, Any] = field(
        default_factory=dict,
    )

    @property
    def document_id(
        self,
    ) -> str:

        return self.document.document_id

    @property
    def document_title(
        self,
    ) -> str:

        return self.document.title

    @property
    def file_path(
        self,
    ) -> str:

        return self.document.file_path

    def export(
        self,
    ) -> dict[str, Any]:

        return {
            "document": self.document.export(),
            "document_id": self.document.document_id,
            "document_title": self.document.title,
            "file_path": self.document.file_path,
            "page": self.page,
            "chunk_id": self.chunk_id,
            "score": self.score,
            "text": self.text,
            "metadata": self.metadata,
        }

    @classmethod
    def from_dict(
        cls,
        data: dict[str, Any],
    ) -> "Citation":

        if "document" in data:

            document = Document.from_dict(
                data["document"],
            )

        else:

            document = Document(
                document_id=data.get(
                    "document_id",
                    "",
                ),
                title=data.get(
                    "document_title",
                    "",
                ),
                file_path=data.get(
                    "file_path",
                    "",
                ),
                metadata=data.get(
                    "document_metadata",
                    {},
                ),
            )

        return cls(
            document=document,
            page=data.get(
                "page",
                0,
            ),
            chunk_id=data.get(
                "chunk_id",
                "",
            ),
            score=data.get(
                "score",
                0.0,
            ),
            text=data.get(
                "text",
                "",
            ),
            metadata=data.get(
                "metadata",
                {},
            ),
        )