from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any


@dataclass(slots=True)
class Citation:

    document_id: str = ""

    document_title: str = ""

    file_path: str = ""

    page: int = 0

    chunk_id: str = ""

    score: float = 0.0

    text: str = ""

    metadata: dict[str, Any] = field(
        default_factory=dict,
    )

    def export(
        self,
    ) -> dict[str, Any]:

        return {
            "document_id": self.document_id,
            "document_title": self.document_title,
            "file_path": self.file_path,
            "page": self.page,
            "chunk_id": self.chunk_id,
            "score": self.score,
            "text": self.text,
            "metadata": self.metadata,
        }

    @classmethod
    def from_dict(
        cls,
        data: dict[str, Any],
    ) -> "Citation":

        return cls(
            document_id=data.get(
                "document_id",
                "",
            ),
            document_title=data.get(
                "document_title",
                "",
            ),
            file_path=data.get(
                "file_path",
                "",
            ),
            page=data.get(
                "page",
                0,
            ),
            chunk_id=data.get(
                "chunk_id",
                "",
            ),
            score=data.get(
                "score",
                0.0,
            ),
            text=data.get(
                "text",
                "",
            ),
            metadata=data.get(
                "metadata",
                {},
            ),
        )