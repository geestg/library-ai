from __future__ import annotations

import json

from pathlib import Path
from datetime import datetime



class ResearchMemory:


    def __init__(self):

        self.base = Path(
            "runtime/research_memory"
        )

        self.base.mkdir(
            parents=True,
            exist_ok=True
        )



    def _file(
        self,
        session_id:str
    ):

        return self.base / f"{session_id}.json"



    def load(
        self,
        session_id:str
    ):

        file = self._file(
            session_id
        )


        if not file.exists():

            return {

                "history": [],

                "last_query": "",

                "last_answer": "",

                "topics": []

            }


        return json.loads(
            file.read_text(
                encoding="utf-8"
            )
        )



    def save(
        self,
        session_id:str,
        query:str,
        answer:str
    ):

        data = self.load(
            session_id
        )


        data["history"].append(
            {
                "role":"user",
                "content":query
            }
        )


        data["history"].append(
            {
                "role":"assistant",
                "content":answer
            }
        )


        data["last_query"] = query

        data["last_answer"] = answer


        if query not in data["topics"]:

            data["topics"].append(query)


        data["updated_at"] = (
            datetime.utcnow()
            .isoformat()
        )


        self._file(
            session_id
        ).write_text(

            json.dumps(
                data,
                indent=2,
                ensure_ascii=False
            ),

            encoding="utf-8"

        )


        return data
