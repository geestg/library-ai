import {
    repositoryBackend,
} from "./backend";

export interface UploadFile {

    name: string;

    size: number;

    files: [File];
}

export class RepositoryUploadFlow {

    async upload(
        upload: UploadFile,
    ) {

        return repositoryBackend.upload({
            files: [upload.file],
        });
    }
}

export const repositoryUploadFlow =
    new RepositoryUploadFlow();
