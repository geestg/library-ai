cat > .gitignore <<'EOF'
# ==========================================
# ENVIRONMENT VARIABLES
# ==========================================

.env
.env.*
!.env.example


# ==========================================
# PYTHON
# ==========================================

__pycache__/
*.py[cod]
*$py.class
*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
htmlcov/


# ==========================================
# PYTHON VIRTUAL ENVIRONMENTS
# ==========================================

venv/
.venv/
env/
ENV/


# ==========================================
# NODE / FRONTEND
# ==========================================

node_modules/
dist/
build/

.vite/
.cache/
.eslintcache

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ==========================================
# LOCAL DATABASE / STORAGE
# ==========================================

*.db
*.sqlite
*.sqlite3

.qdrant/
qdrant_storage/

postgres_data/
minio_data/


# ==========================================
# LOGS
# ==========================================

*.log
logs/


# ==========================================
# TEMPORARY FILES
# ==========================================

tmp/
temp/

*.tmp
*.temp
*.swp
*.swo


# ==========================================
# TEST OUTPUT
# ==========================================

coverage/
test-results/


# ==========================================
# BACKUP FILES
# ==========================================

*.bak
*.backup
*.old


# ==========================================
# IDE
# ==========================================

.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# ==========================================
# OS
# ==========================================

.DS_Store
Thumbs.db
desktop.ini


# ==========================================
# DELBOT PLATFORM RUNTIME
# ==========================================

platform/runtime/
platform/cache/
platform/logs/
platform/models/
platform/data/


# ==========================================
# DELBOT RUNTIME
# ==========================================

runtime/

# allow empty runtime structure only
!runtime/
!runtime/.gitkeep


# ==========================================
# DOCUMENT INGESTION OUTPUT
# ==========================================

documents_tree.txt

*.bin
*.index
*.embedding


# ==========================================
# DATASET LARGE FILES
# ==========================================

repository_data/**/*.pdf
repository_data/**/*.zip


EOF
# Runtime
runtime/
cache/

# Vector database
data/qdrant/

# Local repository data
repository/raw/

# Temporary backups
*.before_*

# DELBot data
delbot_platform/repository_data/
tools/qdrant
*.bin
*.index
*.sqlite